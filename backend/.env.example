# PostgreSQL Connection String (Port 5433 avoids conflict with local Mac postgres on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_pos?schema=public"

# Server Port (Port 5050 is guaranteed free and avoids macOS AirPlay on 5000/5001)
PORT=5050

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
